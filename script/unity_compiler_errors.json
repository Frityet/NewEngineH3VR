{
  "schemaVersion": 1,
  "patterns": [
    "(?im)^\\s*(?:Shader|Compute(?: shader)?)\\s+error\\b",
    "(?im)^.*\\berror\\s+(?:CS|BC)\\d+\\s*:",
    "(?im)^\\s*(?:fatal\\s+)?error\\s*:",
    "(?im)^\\s*(?:Metal(?:\\s+Shader\\s+Compiler)?|MTL\\w*).*?\\b(?:error|failed|failure)\\b",
    "(?im)^.*(?:failed\\s+to\\s+compile|compilation\\s+failed|compiler\\s+error).*(?:shader|metal|compute)",
    "(?im)^.*(?:shader|metal|compute).*(?:failed\\s+to\\s+compile|compilation\\s+failed|compiler\\s+error)",
    "(?im)^.*(?:failed\\s+to\\s+create|creation\\s+failed).*(?:pipeline|shader)",
    "(?im)^.*Shader compiler.*(?:crash|disconnected|failed|timed out)",
    "(?im)^\\s*(?:Assertion failed|[A-Za-z0-9_.]+Exception:)",
    "(?im)^.*program_source:.*\\berror:",
    "(?im)^.*Build completed with a result of [\\'\\\"]?Failed\\b"
  ]
}
