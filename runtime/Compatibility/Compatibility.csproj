<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>netstandard2.1</TargetFramework><ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable><AssemblyName>NativeH3VR.Compat</AssemblyName></PropertyGroup>
  <ItemGroup><Reference Include="$(UnityEngineAssemblies)/UnityEngine*.dll" Private="false" /></ItemGroup>
  <Target Name="RequireUnity" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(UnityEngineAssemblies)/UnityEngine.CoreModule.dll')" Text="Set UnityEngineAssemblies to the Unity 6.7 scripting assembly directory." /></Target>
</Project>
