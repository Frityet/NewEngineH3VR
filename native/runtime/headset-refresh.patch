-NSArray<NSDictionary *> *IVHMDDisplayInventory(void) {
+// Read-only ABI already exercised by hmd-display-probe. Never resolve or call
+// the private mode transaction functions here: those broke physical output.
+static NSDictionary *IVReadHMDModes(id device) {
+    if (NSProcessInfo.processInfo.operatingSystemVersion.majorVersion != 27) return @{};
+    typedef CFDictionaryRef (*CopyCapabilities)(CFTypeRef);
+    typedef int32_t (*CopyCurrent)(CFTypeRef, uintptr_t, CFTypeRef *);
+    typedef uint32_t (*Dimension)(CFTypeRef);
+    typedef double (*Refresh)(CFTypeRef);
+    typedef CFTypeID (*TypeID)(void);
+    CopyCapabilities capabilities = (CopyCapabilities)dlsym(RTLD_DEFAULT, "SLSHMDCopyCapabilities");
+    CopyCurrent current = (CopyCurrent)dlsym(RTLD_DEFAULT, "SLSHMDModeConfigurationCopyCurrentCGSDisplayMode");
+    Dimension width = (Dimension)dlsym(RTLD_DEFAULT, "SLDisplayModeGetPixelWidth");
+    Dimension height = (Dimension)dlsym(RTLD_DEFAULT, "SLDisplayModeGetPixelHeight");
+    Refresh refresh = (Refresh)dlsym(RTLD_DEFAULT, "SLDisplayModeGetRefreshRate");
+    TypeID modeType = (TypeID)dlsym(RTLD_DEFAULT, "SLDisplayModeGetTypeID");
+    const CFStringRef *key = dlsym(RTLD_DEFAULT, "kSLSHMDCapabilityCGDisplayModes");
+    if (!capabilities || !current || !width || !height || !refresh || !modeType || !key || !*key) return @{};
+    unsigned count = 0;
+    Ivar *ivars = class_copyIvarList(NSClassFromString(@"NSHMDDevice"), &count);
+    CFTypeRef hmd = NULL;
+    for (unsigned i = 0; i < count; i++) {
+        const char *encoding = ivar_getTypeEncoding(ivars[i]);
+        if (ivar_getOffset(ivars[i]) == 8 && encoding && encoding[0] == '^' && strstr(encoding, "SLSHMD")) {
+            memcpy(&hmd, (const uint8_t *)(__bridge const void *)device + 8, sizeof(hmd));
+            break;
+        }
+    }
+    free(ivars);
+    if (!hmd) return @{};
+    NSDictionary *(^describe)(CFTypeRef) = ^NSDictionary *(CFTypeRef mode) {
+        if (!mode || CFGetTypeID(mode) != modeType()) return nil;
+        double hz = refresh(mode);
+        if (!isfinite(hz) || hz <= 0) return nil;
+        return @{@"width":@(width(mode)), @"height":@(height(mode)), @"hz":@(hz)};
+    };
+    NSMutableDictionary *result = NSMutableDictionary.new;
+    NSMutableArray *modes = NSMutableArray.new;
+    CFDictionaryRef caps = capabilities(hmd);
+    if (caps && CFGetTypeID(caps) == CFDictionaryGetTypeID()) {
+        CFTypeRef list = CFDictionaryGetValue(caps, *key);
+        if (list && CFGetTypeID(list) == CFArrayGetTypeID()) {
+            for (CFIndex i = 0; i < CFArrayGetCount(list); i++) {
+                NSDictionary *mode = describe(CFArrayGetValueAtIndex(list, i));
+                if (mode && ![modes containsObject:mode]) [modes addObject:mode];
+            }
+        }
+    }
+    if (caps) CFRelease(caps);
+    result[@"modes"] = modes;
+    CFTypeRef selected = NULL;
+    int32_t status = current(hmd, 0, &selected);
+    if (!status && selected) {
+        NSDictionary *mode = describe(selected);
+        if (mode) [result addEntriesFromDictionary:mode];
+    }
+    if (selected) CFRelease(selected);
+    return result;
+}
+
+static NSArray<NSDictionary *> *IVHMDInventory(BOOL includeModes) {
     NSMutableArray *result = [NSMutableArray array];
     for (IVPrivateHMDDevice *device in IVDevices()) {
         if (!IVDeviceSupported(device)) continue;
-        [result addObject:@{@"name": device.name ?: @"Head-mounted display",
+        NSMutableDictionary *entry = [@{@"name": device.name ?: @"Head-mounted display",
                             @"vendor": @(device.vendorID), @"model": @(device.productID),
                             @"builtin": @NO, @"mirrored": @NO, @"native_hmd": @YES,
                             @"attached": @(device.isAttached), @"awake": @(device.isAwake),
-                            @"advisory_available": @(device.isAvailable)}];
+                            @"advisory_available": @(device.isAvailable)} mutableCopy];
+        if (includeModes && device.isAttached) [entry addEntriesFromDictionary:IVReadHMDModes(device)];
+        [result addObject:entry];
     }
     return result;
 }
+
+NSArray<NSDictionary *> *IVHMDDisplayInventory(void) { return IVHMDInventory(NO); }
+NSArray<NSDictionary *> *IVHMDDisplayModeInventory(void) { return IVHMDInventory(YES); }
 
