<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>0436</NoWarn>
    <DefineConstants Condition="'$(LookupCandidate)' != 'false'">$(DefineConstants);NEWENGINE_UNITY_2021</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../managed/NativeSteamVRInput.cs" />
    <Compile Include="../managed/NativeSteamVRBootstrap.cs" />
    <Compile Include="../managed/NativeDiagnosticInput.cs" />
    <Compile Include="$(GeneratedBaseline)/*.cs" />
    <Reference Include="NativeH3VR.Game">
      <HintPath>$(GameManaged)/NativeH3VR.Game.dll</HintPath>
    </Reference>
    <Reference Include="NativeH3VR.FirstPass">
      <HintPath>$(GameManaged)/NativeH3VR.FirstPass.dll</HintPath>
    </Reference>
    <Reference Include="NativeH3VR.SteamVR.Adapter">
      <HintPath>$(GameManaged)/NativeH3VR.SteamVR.Adapter.dll</HintPath>
    </Reference>
    <Reference Include="NativeH3VR.XR.Managed">
      <HintPath>$(GameManaged)/NativeH3VR.XR.Managed.dll</HintPath>
    </Reference>
    <Reference Include="Valve.Newtonsoft.Json">
      <HintPath>$(GameManaged)/Valve.Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
