<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>NativeH3VR.GraphicsOptionsWitness</AssemblyName>
    <DefineConstants>$(DefineConstants);UNITY_6000_0_OR_NEWER;NATIVEH3VR_GAME_WITNESS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ShaderParity/*Swatches.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../ShaderParity/RetailThermalWitness.cs" Link="RetailThermalWitness.cs" />
    <Compile Include="../ShaderParity/OpticBlitWitness.cs" Link="OpticBlitWitness.cs" />
    <Reference Include="$(NativeH3VRManaged)/UnityEngine*.dll" Private="false" />
    <Reference Include="$(NativeH3VRManaged)/NativeH3VR.*.dll" Private="false" />
    <Reference Include="$(NativeH3VRManaged)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(NativeH3VRManaged)/Valve.Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
</Project>
