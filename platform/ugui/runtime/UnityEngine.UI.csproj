<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>UnityEngine.UI</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>UNITY_2020_3;UNITY_2020_3_OR_NEWER;UNITY_2020_1_OR_NEWER;UNITY_2019_1_OR_NEWER;UNITY_2018_1_OR_NEWER;UNITY_2017_1_OR_NEWER;UNITY_STANDALONE;UNITY_STANDALONE_OSX;PACKAGE_PHYSICS;PACKAGE_PHYSICS2D;PACKAGE_TILEMAP;PACKAGE_ANIMATION</DefineConstants>
    <UnityRoot Condition="'$(UnityRoot)'==''">$(UnityContents)</UnityRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityRoot)/Resources/PackageManager/BuiltInPackages/com.unity.ugui/Runtime/**/*.cs" />
    <Reference Include="$(UnityRoot)/PlaybackEngines/MacStandaloneSupport/Variations/mono/Managed/UnityEngine*.dll" />
  </ItemGroup>
</Project>
